# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clerk Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Owner / Admin Configuration (Clerk User ID of the owner for RLS/Admin verification)
VITE_OWNER_CLERK_ID=user_owner_placeholder
VITE_OWNER_WHATSAPP=+919876543210
VITE_OWNER_UPI_ID=animemax@upi

# Cloudinary Image Hosting (client-safe values only — NEVER add CLOUDINARY_API_SECRET here)
# Create a free Cloudinary account, then fill in your Cloud Name.
# Create two unsigned upload presets (Settings → Upload):
#   animemax_products: folder=animemax/products, jpg/png/webp, max 5 MB
#   animemax_banners:  folder=animemax/banners,  jpg/png/webp, max 5 MB
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_PRODUCTS_PRESET=animemax_products
VITE_CLOUDINARY_BANNERS_PRESET=animemax_banners
